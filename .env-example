MUMZIC_PASSWORD=password
MUMZIC_SERVER=localhost
MUMZIC_USER=mumzic

# Web UI: address to listen on inside the container, e.g. :8080 (leave empty to disable).
# Also uncomment "ports" in docker-compose.yml
MUMZIC_WEB=
# Address users open the web UI at, used for the links the bot sends with !web
# e.g. https://music.example.com (defaults to http://localhost:<port>)
MUMZIC_WEB_URL=
# How long a !web link stays valid, e.g. 12h or 30m
MUMZIC_WEB_TOKEN_TTL=12h
